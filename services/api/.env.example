# Names/placeholders only. Export actual local values; .env is not loaded automatically.
JOUS_ENVIRONMENT=<development-test-or-production>
JOUS_SERVICE_NAME=<service-name>
JOUS_LOG_LEVEL=<DEBUG-INFO-WARNING-ERROR-CRITICAL>
JOUS_API_HOST=<bind-host>
JOUS_API_PORT=<bind-port>
JOUS_DATABASE_URL=<dedicated-jous-postgresql-url>
JOUS_DATABASE_TIMEOUT_SECONDS=<positive-seconds-between-0.1-and-30>
